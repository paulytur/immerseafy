# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site
NEXT_PUBLIC_SITE_URL=https://immerseafy.com
NEXT_PUBLIC_FORMSPREE_ID=your_formspree_form_id

# Email (Resend) — https://resend.com/api-keys
# Free tier: 3,000 emails/month (100/day). Used for booking + staff login emails.
RESEND_API_KEY=re_your_api_key
# Use onboarding@resend.dev for testing only — delivers to your Resend account email.
# For real customers, verify your domain at resend.com/domains, then use e.g.:
# RESEND_FROM_EMAIL=Immerseafy <bookings@yourdomain.com>
RESEND_FROM_EMAIL=Immerseafy Freediving <bookings@immerseafy.com>

# Optional: connect Resend SMTP in Supabase Dashboard → Authentication → Email → SMTP
# so auth emails (password reset, magic links) bypass the 2/hour built-in limit.
# Host: smtp.resend.com | Port: 465 | User: resend | Pass: your RESEND_API_KEY

# Cron (Vercel) — set in Vercel dashboard for production
CRON_SECRET=generate_a_random_secret
